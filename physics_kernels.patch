+#ifndef NO_CBLAS
+static float c_api_check_3dotxy_dotxz(blasint n,  blasint incx1, blasint incx2, blasint incx3, blasint incy1, blasint incy2, blasint incy3, blasint incw1, blasint incw2, blasint incw3, blasint incr, blasint incq)
+{
+    blasint i;
+    float maxdiff = 0.0;
+
+    for (i = 0; i < n * labs(incr) * 2; i++) r_buf[i] = 0.0;
+    for (i = 0; i < n * labs(incq) * 2; i++) q_buf[i] = 0.0;
+
+    cblas_c3dotxy_dotxz(n, x1_buf, incx1, x2_buf, incx2, x3_buf, incx3, y1_buf, incy1, y2_buf, incy2, y3_buf, incy3, w1_buf, incw1, w2_buf, incw2, w3_buf, incw3, r_buf, incr, q_buf, incq);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        float d = fabsf(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+    for (i = 0; i < n * labs(incq) * 2; i++) {
+        float d = fabsf(q_buf[i] - q_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+
+    return maxdiff;
+}
+#endif
+
