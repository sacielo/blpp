+
+#include "common.h"
+
+int CNAME(BLASLONG n, BLASLONG dummy0, BLASLONG dummy1,
+          FLOAT *q, BLASLONG incq, FLOAT *r, BLASLONG incr)
+{
+	BLASLONG i = 0;
+	BLASLONG or;
+
+	if ( n < 0 )  return(0);
+
+	while (i < n) {
+		or = (incr >= 0) ? i * incr : (n - 1 - i) * (-incr);
+		r[or] = -42;
+		i++;
+	}
+	return(0);
+}
