+
+#define DATASIZE 100
+#define INCREMENT 2
+#define BUFFER (DATASIZE * INCREMENT * 2)
+
+#ifdef BUILD_COMPLEX16
+static double x1_buf[BUFFER];
+static double x2_buf[BUFFER];
+static double x3_buf[BUFFER];
+static double y1_buf[BUFFER];
+static double y2_buf[BUFFER];
+static double y3_buf[BUFFER];
+static double r_buf[BUFFER];
+static double r_ref[BUFFER];
+
+static double check_3dot(blasint n, blasint incx1, blasint incx2, blasint incx3,
+                         blasint incy1, blasint incy2, blasint incy3, blasint incr)
+{
+    blasint i;
+    double maxdiff = 0.0;
+
+    drand_generate(x1_buf, n * labs(incx1) * 2);
+    drand_generate(x2_buf, n * labs(incx2) * 2);
+    drand_generate(x3_buf, n * labs(incx3) * 2);
+    drand_generate(y1_buf, n * labs(incy1) * 2);
+    drand_generate(y2_buf, n * labs(incy2) * 2);
+    drand_generate(y3_buf, n * labs(incy3) * 2);
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        r_buf[i] = 0.0;
+        r_ref[i] = 0.0;
+    }
+
+    for (i = 0; i < n; i++) {
+        blasint ox1 = (incx1 >= 0) ? i * incx1 : (n - 1 - i) * (-incx1);
+        blasint ox2 = (incx2 >= 0) ? i * incx2 : (n - 1 - i) * (-incx2);
+        blasint ox3 = (incx3 >= 0) ? i * incx3 : (n - 1 - i) * (-incx3);
+        blasint oy1 = (incy1 >= 0) ? i * incy1 : (n - 1 - i) * (-incy1);
+        blasint oy2 = (incy2 >= 0) ? i * incy2 : (n - 1 - i) * (-incy2);
+        blasint oy3 = (incy3 >= 0) ? i * incy3 : (n - 1 - i) * (-incy3);
+        blasint orr = (incr  >= 0) ? i * incr  : (n - 1 - i) * (-incr);
+        double x1r = x1_buf[2 * ox1], x1i = x1_buf[2 * ox1 + 1];
+        double x2r = x2_buf[2 * ox2], x2i = x2_buf[2 * ox2 + 1];
+        double x3r = x3_buf[2 * ox3], x3i = x3_buf[2 * ox3 + 1];
+        double y1r = y1_buf[2 * oy1], y1i = y1_buf[2 * oy1 + 1];
+        double y2r = y2_buf[2 * oy2], y2i = y2_buf[2 * oy2 + 1];
+        double y3r = y3_buf[2 * oy3], y3i = y3_buf[2 * oy3 + 1];
+        r_ref[2 * orr]     = x1r * y1r - x1i * y1i + x2r * y2r - x2i * y2i + x3r * y3r - x3i * y3i;
+        r_ref[2 * orr + 1] = x1r * y1i + x1i * y1r + x2r * y2i + x2i * y2r + x3r * y3i + x3i * y3r;
+    }
+
+    BLASFUNC(z3dot)(&n, x1_buf, &incx1, x2_buf, &incx2, x3_buf, &incx3,
+                    y1_buf, &incy1, y2_buf, &incy2, y3_buf, &incy3, r_buf, &incr);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        double d = fabs(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+    return maxdiff;
+}
+
+#ifndef NO_CBLAS
+static double c_api_check_3dot(blasint n, blasint incx1, blasint incx2, blasint incx3,
+                               blasint incy1, blasint incy2, blasint incy3, blasint incr)
+{
+    blasint i;
+    double maxdiff = 0.0;
+
+    for (i = 0; i < n * labs(incr) * 2; i++)
+        r_buf[i] = 0.0;
+
+    cblas_z3dot(n, x1_buf, incx1, x2_buf, incx2, x3_buf, incx3,
+                y1_buf, incy1, y2_buf, incy2, y3_buf, incy3, r_buf, incr);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        double d = fabs(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+    return maxdiff;
+}
+#endif
+
+CTEST(z3dot, inc_1_1_1_1_1_1_1_N_100)
+{
+    double diff = check_3dot(DATASIZE, 1, 1, 1, 1, 1, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0, diff, DOUBLE_EPS);
+}
+
+CTEST(z3dot, incx2_2_N_100)
