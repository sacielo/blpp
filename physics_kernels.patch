+AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
+IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
+ARE DISCLAIMED. IN NO EVENT SHALL THE OPENBLAS PROJECT OR CONTRIBUTORS BE
+LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL
+DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR
+SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER
+CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY,
+OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE
+USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+*****************************************************************************/
+
+#include <stdio.h>
+#include "common.h"
+#ifdef FUNCTION_PROFILE
+#include "functable.h"
+#endif
+#if  defined(Z13)
+#define MULTI_THREAD_MINIMAL  200000
+#else
+#define MULTI_THREAD_MINIMAL  10000
+#endif
+#ifndef CBLAS
+
+void NAME(blasint *N, FLOAT *A, FLOAT *q, blasint *INCQ, FLOAT *t, blasint *INCT, FLOAT *r, blasint *INCR){
+
+  BLASLONG n    = *N;
+  FLOAT a       = *A;
+  BLASLONG incq = *INCQ;
+  BLASLONG inct = *INCT;
+  BLASLONG incr = *INCR;
+
+#else
+
+void CNAME(blasint n, FLOAT a, FLOAT *q, blasint incq, FLOAT *t, blasint inct, FLOAT *r, blasint incr){
+
+#endif
+
+#ifdef SMP
+  int mode, nthreads;
+#endif
+
+#ifndef CBLAS
+  PRINT_DEBUG_NAME;
+#else
+  PRINT_DEBUG_CNAME;
+#endif
+
+  if (n <= 0) return;
+
+  IDEBUG_START;
+
+  FUNCTION_PROFILE_START();
+
+  if (incq < 0) q -= (n - 1) * incq;
+  if (inct < 0) t -= (n - 1) * inct;
+  if (incr < 0) r -= (n - 1) * incr;
+
+#ifdef SMP
+  //disable multi-thread when incq==0 or inct==0 or incr==0
+  //In that case, the threads would be dependent.
+  //
+  //Temporarily work-around the low performance issue with small input size &
+  //multithreads.
+  if (incq == 0 || inct == 0 || incr == 0 || n <= MULTI_THREAD_MINIMAL)
+	  nthreads = 1;
+  else
+	  nthreads = num_cpu_avail(1);
+
+  if (nthreads == 1) {
+#endif
+
+  XYPA_K(n, 0, 0, a, q, incq, t, inct, r, incr, NULL, 0);
+
+#ifdef SMP
+  } else {
+
+#ifdef XDOUBLE
+    mode  =  BLAS_XDOUBLE | BLAS_REAL;
+#elif defined(DOUBLE)
+    mode  =  BLAS_DOUBLE  | BLAS_REAL;
+#else
+    mode  =  BLAS_SINGLE  | BLAS_REAL;
+#endif
+
+    blas_level1_thread(mode, n, 0, 0, &a,
+		       q, incq, t, inct, r, incr, (int (*)(void))XYPA_K, nthreads);
+
+  }
+#endif
+
+  FUNCTION_PROFILE_END(1, 3 * n, 3 * n);
+
+  IDEBUG_END;
+
+  return;
+
+}
