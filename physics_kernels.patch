+/**********************************************************************************/
+/*                                                                                */
+/*  c3sqr kernel unit tests                                                      */
+/*                                                                                */
+/**********************************************************************************/
+
+#include "utest/openblas_utest.h"
+#include "common.h"
+
+#define DATASIZE 100
+#define INCREMENT 2
+#define BUFFER (DATASIZE * INCREMENT * 2)
+
+#ifdef BUILD_COMPLEX
+static float x1_buf[BUFFER];
+static float x2_buf[BUFFER];
+static float x3_buf[BUFFER];
+static float r_buf[BUFFER];
+static float r_ref[BUFFER];
+
+static void c_prod(float *o0, float *o1, float a0, float a1, float b0, float b1) {
+    *o0 = a0 * b0 - a1 * b1;
+    *o1 = a0 * b1 + a1 * b0;
+}
+
+static float check_3sqr(blasint n,  blasint incx1, blasint incx2, blasint incx3, blasint incr)
+{
+    blasint i;
+    float maxdiff = 0.0;
+
+    srand_generate(x1_buf, n * labs(incx1) * 2);
+    srand_generate(x2_buf, n * labs(incx2) * 2);
+    srand_generate(x3_buf, n * labs(incx3) * 2);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) r_buf[i] = 0.0;
+    for (i = 0; i < n * labs(incr) * 2; i++) r_ref[i] = 0.0;
+
+    for (i = 0; i < n; i++) {
+    blasint ox1,
+         ox2,
+         ox3,
+         or;
+        ox1 = (incx1 >= 0) ? i * incx1 : (n - 1 - i) * (-incx1);
+        ox2 = (incx2 >= 0) ? i * incx2 : (n - 1 - i) * (-incx2);
+        ox3 = (incx3 >= 0) ? i * incx3 : (n - 1 - i) * (-incx3);
+        or = (incr >= 0) ? i * incr : (n - 1 - i) * (-incr);
+
+        {
+        float s0, s1, p0, p1;
+        c_prod(&p0, &p1, x1_buf[2*ox1], x1_buf[2*ox1+1], x1_buf[2*ox1], x1_buf[2*ox1+1]);
+        s0 = p0; s1 = p1;
+        c_prod(&p0, &p1, x2_buf[2*ox2], x2_buf[2*ox2+1], x2_buf[2*ox2], x2_buf[2*ox2+1]);
+        s0 += p0; s1 += p1;
+        c_prod(&p0, &p1, x3_buf[2*ox3], x3_buf[2*ox3+1], x3_buf[2*ox3], x3_buf[2*ox3+1]);
+        s0 += p0; s1 += p1;
+        r_ref[2*or] = s0; r_ref[2*or+1] = s1;
+        }
+    }
+
+    BLASFUNC(c3sqr)(&n, x1_buf, &incx1, x2_buf, &incx2, x3_buf, &incx3, r_buf, &incr);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        float d = fabsf(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+
+    return maxdiff;
+}
+
+#ifndef NO_CBLAS
+static float c_api_check_3sqr(blasint n,  blasint incx1, blasint incx2, blasint incx3, blasint incr)
+{
+    blasint i;
+    float maxdiff = 0.0;
+
+    for (i = 0; i < n * labs(incr) * 2; i++) r_buf[i] = 0.0;
+
+    cblas_c3sqr(n, x1_buf, incx1, x2_buf, incx2, x3_buf, incx3, r_buf, incr);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        float d = fabsf(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+
+    return maxdiff;
+}
+#endif
+
+CTEST(c3sqr, all_1_N_100)
+{
+    float diff = check_3sqr(DATASIZE, 1,1,1,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c3sqr, c_api_all_1_N_100)
+{
+    float diff = c_api_check_3sqr(DATASIZE, 1,1,1,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c3sqr, incx2_2_N_100)
+{
+    float diff = check_3sqr(DATASIZE, 1,2,1,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c3sqr, c_api_incx2_2_N_100)
+{
+    float diff = c_api_check_3sqr(DATASIZE, 1,2,1,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c3sqr, incr_2_N_100)
+{
+    float diff = check_3sqr(DATASIZE, 1,1,1,2);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c3sqr, c_api_incr_2_N_100)
+{
+    float diff = c_api_check_3sqr(DATASIZE, 1,1,1,2);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c3sqr, all_2_N_100)
+{
+    float diff = check_3sqr(DATASIZE, 2,2,2,2);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c3sqr, c_api_all_2_N_100)
+{
+    float diff = c_api_check_3sqr(DATASIZE, 2,2,2,2);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c3sqr, neg_incx1_N_100)
+{
+    float diff = check_3sqr(DATASIZE, -1,1,1,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c3sqr, c_api_neg_incx1_N_100)
+{
+    float diff = c_api_check_3sqr(DATASIZE, -1,1,1,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c3sqr, neg_incr_N_100)
+{
+    float diff = check_3sqr(DATASIZE, 1,1,1,-1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c3sqr, c_api_neg_incr_N_100)
+{
+    float diff = c_api_check_3sqr(DATASIZE, 1,1,1,-1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c3sqr, neg_all_N_100)
+{
+    float diff = check_3sqr(DATASIZE, -2,-2,-2,-1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c3sqr, c_api_neg_all_N_100)
+{
+    float diff = c_api_check_3sqr(DATASIZE, -2,-2,-2,-1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c3sqr, incx1_0_N_100)
+{
+    float diff = check_3sqr(DATASIZE, 0,1,1,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c3sqr, c_api_incx1_0_N_100)
+{
+    float diff = c_api_check_3sqr(DATASIZE, 0,1,1,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c3sqr, n_zero)
+{
+    float diff = check_3sqr(0, 1, 1, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c3sqr, c_api_n_zero)
+{
+    float diff = c_api_check_3sqr(0, 1, 1, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+#endif
