+
+#include "common.h"
+
+int CNAME(BLASLONG n, BLASLONG dummy0, BLASLONG dummy1, FLOAT ar, FLOAT ai,
+          FLOAT *q, BLASLONG incq, FLOAT *t, BLASLONG inct, FLOAT *r,
+          BLASLONG incr, FLOAT *dummy, BLASLONG dummy2)
+{
+	BLASLONG i = 0;
+	BLASLONG iq = 0;
+	BLASLONG it = 0;
+	BLASLONG ir = 0;
+	BLASLONG incq2 = 2 * incq;
+	BLASLONG inct2 = 2 * inct;
+	BLASLONG incr2 = 2 * incr;
+	FLOAT qr, qi, tr, ti;
+
+	if ( n < 0 )  return(0);
+
+	if ( incr == 0 )
+	{
+		r[0]     = q[0] * t[0] - q[1] * t[1] + ar;
+		r[1]     = q[0] * t[1] + q[1] * t[0] + ai;
+		return(0);
+	}
+
+	if ( incq == 1 && inct == 1 && incr == 1 )
+	{
+		for (i = 0; i + 4 <= n; i += 4)
+		{
+			qr = q[2 * i];     qi = q[2 * i + 1];
+			tr = t[2 * i];     ti = t[2 * i + 1];
+			r[2 * i]     = qr * tr - qi * ti + ar;
+			r[2 * i + 1] = qr * ti + qi * tr + ai;
+			qr = q[2 * i + 2]; qi = q[2 * i + 3];
+			tr = t[2 * i + 2]; ti = t[2 * i + 3];
+			r[2 * i + 2] = qr * tr - qi * ti + ar;
+			r[2 * i + 3] = qr * ti + qi * tr + ai;
+			qr = q[2 * i + 4]; qi = q[2 * i + 5];
+			tr = t[2 * i + 4]; ti = t[2 * i + 5];
+			r[2 * i + 4] = qr * tr - qi * ti + ar;
+			r[2 * i + 5] = qr * ti + qi * tr + ai;
+			qr = q[2 * i + 6]; qi = q[2 * i + 7];
+			tr = t[2 * i + 6]; ti = t[2 * i + 7];
+			r[2 * i + 6] = qr * tr - qi * ti + ar;
+			r[2 * i + 7] = qr * ti + qi * tr + ai;
+		}
+		iq = 2 * i;
+		it = 2 * i;
+		ir = 2 * i;
+	}
+
+	while(i < n)
+	{
+		qr = q[iq];
+		qi = q[iq + 1];
+		tr = t[it];
+		ti = t[it + 1];
+
+		r[ir]     = qr * tr - qi * ti + ar;
+		r[ir + 1] = qr * ti + qi * tr + ai;
+		iq += incq2 ;
+		it += inct2 ;
+		ir += incr2 ;
+		i++ ;
+	}
+	return(0);
+}
