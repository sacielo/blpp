+        double c3r = p0 - q0, c3i = p1 - q1;
+        {
+        double s0 = 0.0, s1 = 0.0;
+        c_prod(&p0, &p1, c1r, c1i, w1_buf[2*ow1], w1_buf[2*ow1+1]); s0 += p0; s1 += p1;
