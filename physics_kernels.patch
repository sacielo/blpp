+    float cdiff = c_api_check_3dot(DATASIZE, -2, -2, -2, -2, -2, -2, -1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+    ASSERT_DBL_NEAR_TOL(0.0f, cdiff, SINGLE_EPS);
+}
+
+CTEST(s3dot, c_api_n_zero)
+{
+    float diff = check_3dot(0, 1, 1, 1, 1, 1, 1, 1);
+    float cdiff = c_api_check_3dot(0, 1, 1, 1, 1, 1, 1, 1);
