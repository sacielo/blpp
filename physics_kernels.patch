+
+#ifdef BUILD_DOUBLE
+static double q_buf[BUFFER];
+static double t_buf[BUFFER];
+static double r_buf[BUFFER];
+static double r_ref[BUFFER];
+
+static double check_1xypa(blasint n, double a, blasint incq, blasint inct, blasint incr)
+{
+    blasint i;
+    double maxdiff = 0.0;
+
+    drand_generate(q_buf, n * labs(incq));
+    drand_generate(t_buf, n * labs(inct));
+    for (i = 0; i < n * labs(incr); i++) {
+        r_buf[i] = 0.0;
+        r_ref[i] = 0.0;
+    }
+
+    for (i = 0; i < n; i++) {
+        blasint oq = (incq >= 0) ? i * incq : (n - 1 - i) * (-incq);
+        blasint ot = (inct >= 0) ? i * inct : (n - 1 - i) * (-inct);
+        blasint orr = (incr >= 0) ? i * incr : (n - 1 - i) * (-incr);
+        r_ref[orr] = q_buf[oq] * t_buf[ot] + a;
+    }
+
+    BLASFUNC(d1xypa)(&n, &a, q_buf, &incq, t_buf, &inct, r_buf, &incr);
+
+    for (i = 0; i < n * labs(incr); i++) {
+        double d = fabs(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+    return maxdiff;
+}
+
+#ifndef NO_CBLAS
+static double c_api_check_1xypa(blasint n, double a, blasint incq, blasint inct, blasint incr)
+{
+    blasint i;
+    double maxdiff = 0.0;
+
+    for (i = 0; i < n * labs(incr); i++)
+        r_buf[i] = 0.0;
+
+    cblas_d1xypa(n, a, q_buf, incq, t_buf, inct, r_buf, incr);
+
+    for (i = 0; i < n * labs(incr); i++) {
+        double d = fabs(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+    return maxdiff;
+}
+#endif
+
+CTEST(d1xypa, inc_q_1_inc_t_1_inc_r_1_N_100)
+{
