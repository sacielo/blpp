+/**********************************************************************************/
+/*                                                                                */
+/*  z3cross kernel unit tests                                                      */
+/*                                                                                */
+/**********************************************************************************/
+
+#include "utest/openblas_utest.h"
+#include "common.h"
+
+#define DATASIZE 100
+#define INCREMENT 2
+#define BUFFER (DATASIZE * INCREMENT * 2)
+
+#ifdef BUILD_COMPLEX16
+static double x1_buf[BUFFER];
+static double x2_buf[BUFFER];
+static double x3_buf[BUFFER];
+static double y1_buf[BUFFER];
+static double y2_buf[BUFFER];
+static double y3_buf[BUFFER];
+static double w1_buf[BUFFER];
+static double w2_buf[BUFFER];
+static double w3_buf[BUFFER];
+static double w1_ref[BUFFER];
+static double w2_ref[BUFFER];
+static double w3_ref[BUFFER];
+
+static void c_prod(double *o0, double *o1, double a0, double a1, double b0, double b1) {
+    *o0 = a0 * b0 - a1 * b1;
+    *o1 = a0 * b1 + a1 * b0;
+}
+
+static float check_3cross(blasint n,  blasint incx1, blasint incx2, blasint incx3, blasint incy1, blasint incy2, blasint incy3, blasint incw1, blasint incw2, blasint incw3)
+{
+    blasint i;
+    double maxdiff = 0.0;
+
+    drand_generate(x1_buf, n * labs(incx1) * 2);
+    drand_generate(x2_buf, n * labs(incx2) * 2);
+    drand_generate(x3_buf, n * labs(incx3) * 2);
+    drand_generate(y1_buf, n * labs(incy1) * 2);
+    drand_generate(y2_buf, n * labs(incy2) * 2);
+    drand_generate(y3_buf, n * labs(incy3) * 2);
+
+    for (i = 0; i < n * labs(incw1) * 2; i++) w1_buf[i] = 0.0;
+    for (i = 0; i < n * labs(incw1) * 2; i++) w1_ref[i] = 0.0;
+    for (i = 0; i < n * labs(incw2) * 2; i++) w2_buf[i] = 0.0;
+    for (i = 0; i < n * labs(incw2) * 2; i++) w2_ref[i] = 0.0;
+    for (i = 0; i < n * labs(incw3) * 2; i++) w3_buf[i] = 0.0;
+    for (i = 0; i < n * labs(incw3) * 2; i++) w3_ref[i] = 0.0;
+
+    for (i = 0; i < n; i++) {
+    blasint ox1,
+         ox2,
+         ox3,
+         oy1,
+         oy2,
+         oy3,
+         ow1,
+         ow2,
+         ow3;
+        ox1 = (incx1 >= 0) ? i * incx1 : (n - 1 - i) * (-incx1);
+        ox2 = (incx2 >= 0) ? i * incx2 : (n - 1 - i) * (-incx2);
+        ox3 = (incx3 >= 0) ? i * incx3 : (n - 1 - i) * (-incx3);
+        oy1 = (incy1 >= 0) ? i * incy1 : (n - 1 - i) * (-incy1);
+        oy2 = (incy2 >= 0) ? i * incy2 : (n - 1 - i) * (-incy2);
+        oy3 = (incy3 >= 0) ? i * incy3 : (n - 1 - i) * (-incy3);
+        ow1 = (incw1 >= 0) ? i * incw1 : (n - 1 - i) * (-incw1);
+        ow2 = (incw2 >= 0) ? i * incw2 : (n - 1 - i) * (-incw2);
+        ow3 = (incw3 >= 0) ? i * incw3 : (n - 1 - i) * (-incw3);
+
+        {
+        double p0, p1, q0, q1;
+        c_prod(&p0, &p1, x2_buf[2*ox2], x2_buf[2*ox2+1], y3_buf[2*oy3], y3_buf[2*oy3+1]);
+        c_prod(&q0, &q1, x3_buf[2*ox3], x3_buf[2*ox3+1], y2_buf[2*oy2], y2_buf[2*oy2+1]);
+        double c1r = p0 - q0, c1i = p1 - q1;
+        c_prod(&p0, &p1, x3_buf[2*ox3], x3_buf[2*ox3+1], y1_buf[2*oy1], y1_buf[2*oy1+1]);
+        c_prod(&q0, &q1, x1_buf[2*ox1], x1_buf[2*ox1+1], y3_buf[2*oy3], y3_buf[2*oy3+1]);
+        double c2r = p0 - q0, c2i = p1 - q1;
+        c_prod(&p0, &p1, x1_buf[2*ox1], x1_buf[2*ox1+1], y2_buf[2*oy2], y2_buf[2*oy2+1]);
+        c_prod(&q0, &q1, x2_buf[2*ox2], x2_buf[2*ox2+1], y1_buf[2*oy1], y1_buf[2*oy1+1]);
+        double c3r = p0 - q0, c3i = p1 - q1;
+        w1_ref[2*ow1] = c1r; w1_ref[2*ow1+1] = c1i;
+        w2_ref[2*ow2] = c2r; w2_ref[2*ow2+1] = c2i;
+        w3_ref[2*ow3] = c3r; w3_ref[2*ow3+1] = c3i;
+        }
+    }
+
+    BLASFUNC(z3cross)(&n, x1_buf, &incx1, x2_buf, &incx2, x3_buf, &incx3, y1_buf, &incy1, y2_buf, &incy2, y3_buf, &incy3, w1_buf, &incw1, w2_buf, &incw2, w3_buf, &incw3);
+
+    for (i = 0; i < n * labs(incw1) * 2; i++) {
+        double d = fabs(w1_buf[i] - w1_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+    for (i = 0; i < n * labs(incw2) * 2; i++) {
+        double d = fabs(w2_buf[i] - w2_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+    for (i = 0; i < n * labs(incw3) * 2; i++) {
+        double d = fabs(w3_buf[i] - w3_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+
+    return maxdiff;
+}
+
+#ifndef NO_CBLAS
+static float c_api_check_3cross(blasint n,  blasint incx1, blasint incx2, blasint incx3, blasint incy1, blasint incy2, blasint incy3, blasint incw1, blasint incw2, blasint incw3)
+{
+    blasint i;
+    double maxdiff = 0.0;
+
+    for (i = 0; i < n * labs(incw1) * 2; i++) w1_buf[i] = 0.0;
+    for (i = 0; i < n * labs(incw2) * 2; i++) w2_buf[i] = 0.0;
+    for (i = 0; i < n * labs(incw3) * 2; i++) w3_buf[i] = 0.0;
+
+    cblas_z3cross(n, x1_buf, incx1, x2_buf, incx2, x3_buf, incx3, y1_buf, incy1, y2_buf, incy2, y3_buf, incy3, w1_buf, incw1, w2_buf, incw2, w3_buf, incw3);
+
+    for (i = 0; i < n * labs(incw1) * 2; i++) {
+        double d = fabs(w1_buf[i] - w1_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+    for (i = 0; i < n * labs(incw2) * 2; i++) {
+        double d = fabs(w2_buf[i] - w2_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+    for (i = 0; i < n * labs(incw3) * 2; i++) {
+        double d = fabs(w3_buf[i] - w3_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+
+    return maxdiff;
+}
+#endif
+
+CTEST(z3cross, all_1_N_100)
+{
+    float diff = check_3cross(DATASIZE, 1,1,1,1,1,1,1,1,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, DOUBLE_EPS);
+}
+
+CTEST(z3cross, c_api_all_1_N_100)
+{
+    float diff = c_api_check_3cross(DATASIZE, 1,1,1,1,1,1,1,1,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, DOUBLE_EPS);
+}
+
+CTEST(z3cross, incx2_2_N_100)
+{
+    float diff = check_3cross(DATASIZE, 1,2,1,1,1,1,1,1,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, DOUBLE_EPS);
+}
