+CTEST(s1norm, c_api_neg_all_N_100)
+{
+    float diff = c_api_check_1norm(DATASIZE, -2,-1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(s1norm, incq_0_N_100)
+{
+    float diff = check_1norm(DATASIZE, 0,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(s1norm, c_api_incq_0_N_100)
+{
+    float diff = c_api_check_1norm(DATASIZE, 0,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
