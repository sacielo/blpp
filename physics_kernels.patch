+    double diff = c_api_check_3dot(DATASIZE, 1, 2, 1, 1, 1, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0, diff, DOUBLE_EPS);
+}
+
+CTEST(z3dot, c_api_inc_2_2_2_2_2_2_2_N_100)
+{
