+    *o0 = a0 * b0 - a1 * b1;
+    *o1 = a0 * b1 + a1 * b0;
+}
+
+static float check_3crosssqr(blasint n,  blasint incx1, blasint incx2, blasint incx3, blasint incy1, blasint incy2, blasint incy3, blasint incr)
+{
+    blasint i;
+    float maxdiff = 0.0;
+
+    srand_generate(x1_buf, n * labs(incx1) * 2);
+    srand_generate(x2_buf, n * labs(incx2) * 2);
+    srand_generate(x3_buf, n * labs(incx3) * 2);
+    srand_generate(y1_buf, n * labs(incy1) * 2);
+    srand_generate(y2_buf, n * labs(incy2) * 2);
+    srand_generate(y3_buf, n * labs(incy3) * 2);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) r_buf[i] = 0.0;
+    for (i = 0; i < n * labs(incr) * 2; i++) r_ref[i] = 0.0;
+
+    for (i = 0; i < n; i++) {
+    blasint ox1,
+         ox2,
+         ox3,
+         oy1,
+         oy2,
+         oy3,
+         or;
+        ox1 = (incx1 >= 0) ? i * incx1 : (n - 1 - i) * (-incx1);
+        ox2 = (incx2 >= 0) ? i * incx2 : (n - 1 - i) * (-incx2);
+        ox3 = (incx3 >= 0) ? i * incx3 : (n - 1 - i) * (-incx3);
+        oy1 = (incy1 >= 0) ? i * incy1 : (n - 1 - i) * (-incy1);
+        oy2 = (incy2 >= 0) ? i * incy2 : (n - 1 - i) * (-incy2);
+        oy3 = (incy3 >= 0) ? i * incy3 : (n - 1 - i) * (-incy3);
+        or = (incr >= 0) ? i * incr : (n - 1 - i) * (-incr);
+
+        {
+        float p0, p1, q0, q1;
+        c_prod(&p0, &p1, x2_buf[2*ox2], x2_buf[2*ox2+1], y3_buf[2*oy3], y3_buf[2*oy3+1]);
+        c_prod(&q0, &q1, x3_buf[2*ox3], x3_buf[2*ox3+1], y2_buf[2*oy2], y2_buf[2*oy2+1]);
+        float c1r = p0 - q0, c1i = p1 - q1;
+        c_prod(&p0, &p1, x3_buf[2*ox3], x3_buf[2*ox3+1], y1_buf[2*oy1], y1_buf[2*oy1+1]);
+        c_prod(&q0, &q1, x1_buf[2*ox1], x1_buf[2*ox1+1], y3_buf[2*oy3], y3_buf[2*oy3+1]);
+        float c2r = p0 - q0, c2i = p1 - q1;
+        c_prod(&p0, &p1, x1_buf[2*ox1], x1_buf[2*ox1+1], y2_buf[2*oy2], y2_buf[2*oy2+1]);
+        c_prod(&q0, &q1, x2_buf[2*ox2], x2_buf[2*ox2+1], y1_buf[2*oy1], y1_buf[2*oy1+1]);
+        float c3r = p0 - q0, c3i = p1 - q1;
+        r_ref[2*or] = c1r * c1r - c1i * c1i + c2r * c2r - c2i * c2i + c3r * c3r - c3i * c3i;
+        r_ref[2*or+1] = 2.0 * (c1r * c1i + c2r * c2i + c3r * c3i);
+        }
