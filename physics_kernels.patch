+USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+
+**********************************************************************************/
+
+#include "utest/openblas_utest.h"
+#include "common.h"
+
+#define DATASIZE 100
+#define INCREMENT 2
+#define BUFFER (DATASIZE * INCREMENT * 2)
+
+#ifdef BUILD_COMPLEX16
+static double q_buf[BUFFER];
+static double t_buf[BUFFER];
+static double r_buf[BUFFER];
+static double r_ref[BUFFER];
+
+static double check_1xypa(blasint n, double *a, blasint incq, blasint inct, blasint incr)
+{
+    blasint i;
+    double maxdiff = 0.0;
+
+    drand_generate(q_buf, n * labs(incq) * 2);
+    drand_generate(t_buf, n * labs(inct) * 2);
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        r_buf[i] = 0.0;
+        r_ref[i] = 0.0;
+    }
+
+    for (i = 0; i < n; i++) {
+        blasint oq = (incq >= 0) ? i * incq : (n - 1 - i) * (-incq);
+        blasint ot = (inct >= 0) ? i * inct : (n - 1 - i) * (-inct);
+        blasint orr = (incr >= 0) ? i * incr : (n - 1 - i) * (-incr);
+        double qr = q_buf[2 * oq];
+        double qi = q_buf[2 * oq + 1];
+        double tr = t_buf[2 * ot];
+        double ti = t_buf[2 * ot + 1];
+        r_ref[2 * orr]     = qr * tr - qi * ti + a[0];
+        r_ref[2 * orr + 1] = qr * ti + qi * tr + a[1];
+    }
+
+    BLASFUNC(z1xypa)(&n, a, q_buf, &incq, t_buf, &inct, r_buf, &incr);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        double d = fabs(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+    return maxdiff;
+}
+
+#ifndef NO_CBLAS
+static double c_api_check_1xypa(blasint n, double *a, blasint incq, blasint inct, blasint incr)
+{
+    blasint i;
+    double maxdiff = 0.0;
+
+    for (i = 0; i < n * labs(incr) * 2; i++)
+        r_buf[i] = 0.0;
+
+    cblas_z1xypa(n, a, q_buf, incq, t_buf, inct, r_buf, incr);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        double d = fabs(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+    return maxdiff;
+}
+#endif
+
+static double a1[2] = {1.0, 0.5};
+
+CTEST(z1xypa, inc_q_1_inc_t_1_inc_r_1_N_100)
+{
+    double diff = check_1xypa(DATASIZE, a1, 1, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0, diff, DOUBLE_EPS);
+}
+
+CTEST(z1xypa, inc_q_2_inc_t_1_inc_r_1_N_100)
+{
+    double diff = check_1xypa(DATASIZE, a1, 2, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0, diff, DOUBLE_EPS);
+}
+
+CTEST(z1xypa, inc_q_2_inc_t_2_inc_r_2_N_100)
+{
+    double diff = check_1xypa(DATASIZE, a1, 2, 2, 2);
+    ASSERT_DBL_NEAR_TOL(0.0, diff, DOUBLE_EPS);
+}
+
+CTEST(z1xypa, inc_q_neg_2_inc_t_neg_2_inc_r_neg_1_N_100)
+{
+    double diff = check_1xypa(DATASIZE, a1, -2, -2, -1);
+    ASSERT_DBL_NEAR_TOL(0.0, diff, DOUBLE_EPS);
+}
+
+CTEST(z1xypa, check_n_zero)
+{
+    double diff = check_1xypa(0, a1, 1, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0, diff, DOUBLE_EPS);
+}
+
+#ifndef NO_CBLAS
+CTEST(z1xypa, c_api_inc_q_1_inc_t_1_inc_r_1_N_100)
+{
+    double diff = check_1xypa(DATASIZE, a1, 1, 1, 1);
+    double cdiff = c_api_check_1xypa(DATASIZE, a1, 1, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0, diff, DOUBLE_EPS);
+    ASSERT_DBL_NEAR_TOL(0.0, cdiff, DOUBLE_EPS);
+}
+
+CTEST(z1xypa, c_api_inc_q_2_inc_t_2_inc_r_2_N_100)
+{
+    double diff = check_1xypa(DATASIZE, a1, 2, 2, 2);
+    double cdiff = c_api_check_1xypa(DATASIZE, a1, 2, 2, 2);
+    ASSERT_DBL_NEAR_TOL(0.0, diff, DOUBLE_EPS);
+    ASSERT_DBL_NEAR_TOL(0.0, cdiff, DOUBLE_EPS);
+}
+
+CTEST(z1xypa, c_api_inc_q_neg_2_inc_t_neg_2_inc_r_neg_1_N_100)
+{
+    double diff = check_1xypa(DATASIZE, a1, -2, -2, -1);
+    double cdiff = c_api_check_1xypa(DATASIZE, a1, -2, -2, -1);
+    ASSERT_DBL_NEAR_TOL(0.0, diff, DOUBLE_EPS);
+    ASSERT_DBL_NEAR_TOL(0.0, cdiff, DOUBLE_EPS);
+}
+
+CTEST(z1xypa, c_api_check_n_zero)
+{
+    double diff = check_1xypa(0, a1, 1, 1, 1);
+    double cdiff = c_api_check_1xypa(0, a1, 1, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0, diff, DOUBLE_EPS);
+    ASSERT_DBL_NEAR_TOL(0.0, cdiff, DOUBLE_EPS);
+}
+#endif
+#endif
