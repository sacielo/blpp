+
+#ifdef BUILD_COMPLEX
+static float q_buf[BUFFER];
+static float t_buf[BUFFER];
+static float r_buf[BUFFER];
+static float r_ref[BUFFER];
+
+static float check_1xypa(blasint n, float *a, blasint incq, blasint inct, blasint incr)
+{
+    blasint i;
+    float maxdiff = 0.0f;
+
+    srand_generate(q_buf, n * labs(incq) * 2);
+    srand_generate(t_buf, n * labs(inct) * 2);
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        r_buf[i] = 0.0f;
+        r_ref[i] = 0.0f;
+    }
+
+    for (i = 0; i < n; i++) {
+        blasint oq = (incq >= 0) ? i * incq : (n - 1 - i) * (-incq);
+        blasint ot = (inct >= 0) ? i * inct : (n - 1 - i) * (-inct);
+        blasint orr = (incr >= 0) ? i * incr : (n - 1 - i) * (-incr);
+        float qr = q_buf[2 * oq];
+        float qi = q_buf[2 * oq + 1];
+        float tr = t_buf[2 * ot];
+        float ti = t_buf[2 * ot + 1];
+        r_ref[2 * orr]     = qr * tr - qi * ti + a[0];
+        r_ref[2 * orr + 1] = qr * ti + qi * tr + a[1];
+    }
+
+    BLASFUNC(c1xypa)(&n, a, q_buf, &incq, t_buf, &inct, r_buf, &incr);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        float d = fabsf(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+    return maxdiff;
+}
+
+#ifndef NO_CBLAS
+static float c_api_check_1xypa(blasint n, float *a, blasint incq, blasint inct, blasint incr)
+{
+    blasint i;
+    float maxdiff = 0.0f;
+
+    for (i = 0; i < n * labs(incr) * 2; i++)
+        r_buf[i] = 0.0f;
+
+    cblas_c1xypa(n, a, q_buf, incq, t_buf, inct, r_buf, incr);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        float d = fabsf(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+    return maxdiff;
+}
+#endif
+
+static float a1[2] = {1.0f, 0.5f};
+
+CTEST(c1xypa, inc_q_1_inc_t_1_inc_r_1_N_100)
+{
+    float diff = check_1xypa(DATASIZE, a1, 1, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c1xypa, inc_q_2_inc_t_1_inc_r_1_N_100)
+{
+    float diff = check_1xypa(DATASIZE, a1, 2, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c1xypa, inc_q_2_inc_t_2_inc_r_2_N_100)
+{
+    float diff = check_1xypa(DATASIZE, a1, 2, 2, 2);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c1xypa, inc_q_neg_2_inc_t_neg_2_inc_r_neg_1_N_100)
