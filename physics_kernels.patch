+USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+*****************************************************************************/
+
+#include "common.h"
+
+int CNAME(BLASLONG n, BLASLONG dummy0, BLASLONG dummy1,
+          FLOAT *x1, BLASLONG incx1, FLOAT *x2, BLASLONG incx2, FLOAT *x3, BLASLONG incx3,
+          FLOAT *y1, BLASLONG incy1, FLOAT *y2, BLASLONG incy2, FLOAT *y3, BLASLONG incy3,
+          FLOAT *w1, BLASLONG incw1, FLOAT *w2, BLASLONG incw2, FLOAT *w3, BLASLONG incw3)
+{
+	BLASLONG i = 0;
+	BLASLONG ix1 = 0, ix2 = 0, ix3 = 0;
+	BLASLONG iy1 = 0, iy2 = 0, iy3 = 0;
+	BLASLONG ow1 = 0, ow2 = 0, ow3 = 0;
+
+	if ( n < 0 )  return(0);
+
+	if ( n > 0 ) {
+		if (incw1 == 0) w1[0] = x1[0] * y1[0];
+		if (incw2 == 0) w2[0] = x2[0] * y2[0];
+		if (incw3 == 0) w3[0] = x3[0] * y3[0];
+	}
+
+	if ((incx1 == 1) && (incx2 == 1) && (incx3 == 1) &&
+	    (incy1 == 1) && (incy2 == 1) && (incy3 == 1) &&
+	    (incw1 == 1) && (incw2 == 1) && (incw3 == 1)) {
+		for (i = 0; i + 3 < n; i += 4) {
+			w1[i]     = x1[i]     * y1[i];
+			w2[i]     = x2[i]     * y2[i];
+			w3[i]     = x3[i]     * y3[i];
+			w1[i + 1] = x1[i + 1] * y1[i + 1];
+			w2[i + 1] = x2[i + 1] * y2[i + 1];
+			w3[i + 1] = x3[i + 1] * y3[i + 1];
+			w1[i + 2] = x1[i + 2] * y1[i + 2];
+			w2[i + 2] = x2[i + 2] * y2[i + 2];
+			w3[i + 2] = x3[i + 2] * y3[i + 2];
+			w1[i + 3] = x1[i + 3] * y1[i + 3];
+			w2[i + 3] = x2[i + 3] * y2[i + 3];
+			w3[i + 3] = x3[i + 3] * y3[i + 3];
+		}
+		while (i < n) {
+			w1[i] = x1[i] * y1[i];
+			w2[i] = x2[i] * y2[i];
+			w3[i] = x3[i] * y3[i];
+			i++;
+		}
+	}
+	else {
+		while (i < n) {
+			if (incw1 != 0) w1[ow1] = x1[ix1] * y1[iy1];
+			if (incw2 != 0) w2[ow2] = x2[ix2] * y2[iy2];
+			if (incw3 != 0) w3[ow3] = x3[ix3] * y3[iy3];
+			ix1 += incx1;
+			ix2 += incx2;
+			ix3 += incx3;
+			iy1 += incy1;
+			iy2 += incy2;
+			iy3 += incy3;
+			ow1 += incw1;
+			ow2 += incw2;
+			ow3 += incw3;
+			i++;
+		}
+	}
+	return(0);
+}
