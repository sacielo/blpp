+        c_prod(&p0, &p1, x2_buf[2*ox2], x2_buf[2*ox2+1], y2_buf[2*oy2], y2_buf[2*oy2+1]); s0 += p0; s1 += p1;
+        c_prod(&p0, &p1, x3_buf[2*ox3], x3_buf[2*ox3+1], y3_buf[2*oy3], y3_buf[2*oy3+1]); s0 += p0; s1 += p1;
+        r_ref[2*or] = s0; r_ref[2*or+1] = s1;
+        s0 = 0.0; s1 = 0.0;
+        c_prod(&p0, &p1, x1_buf[2*ox1], x1_buf[2*ox1+1], w1_buf[2*ow1], w1_buf[2*ow1+1]); s0 += p0; s1 += p1;
+        c_prod(&p0, &p1, x2_buf[2*ox2], x2_buf[2*ox2+1], w2_buf[2*ow2], w2_buf[2*ow2+1]); s0 += p0; s1 += p1;
+        c_prod(&p0, &p1, x3_buf[2*ox3], x3_buf[2*ox3+1], w3_buf[2*ow3], w3_buf[2*ow3+1]); s0 += p0; s1 += p1;
+        q_ref[2*oq] = s0; q_ref[2*oq+1] = s1;
+        }
+    }
+
+    BLASFUNC(c3dotxy_dotxz)(&n, x1_buf, &incx1, x2_buf, &incx2, x3_buf, &incx3, y1_buf, &incy1, y2_buf, &incy2, y3_buf, &incy3, w1_buf, &incw1, w2_buf, &incw2, w3_buf, &incw3, r_buf, &incr, q_buf, &incq);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        float d = fabsf(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+    for (i = 0; i < n * labs(incq) * 2; i++) {
+        float d = fabsf(q_buf[i] - q_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+
+    return maxdiff;
+}
