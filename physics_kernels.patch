+/**********************************************************************************/
+/*                                                                                */
+/*  s1norm kernel unit tests                                                      */
+/*                                                                                */
+/**********************************************************************************/
+
+#include "utest/openblas_utest.h"
+#include "common.h"
+
+#define DATASIZE 100
+#define INCREMENT 2
+#define BUFFER (DATASIZE * INCREMENT * 2)
+
+#ifdef BUILD_SINGLE
+static float q_buf[BUFFER];
+static float r_buf[BUFFER];
+static float r_ref[BUFFER];
+
+
+static float check_1norm(blasint n,  blasint incq, blasint incr)
+{
+    blasint i;
+    float maxdiff = 0.0;
+
+    srand_generate(q_buf, n * labs(incq));
+
+    for (i = 0; i < n * labs(incr); i++) r_buf[i] = 0.0;
+    for (i = 0; i < n * labs(incr); i++) r_ref[i] = 0.0;
+
+    for (i = 0; i < n; i++) {
+    blasint oq,
+         or;
+        oq = (incq >= 0) ? i * incq : (n - 1 - i) * (-incq);
+        or = (incr >= 0) ? i * incr : (n - 1 - i) * (-incr);
+
+        r_ref[or] = sqrtf(q_buf[oq] * q_buf[oq]);
+    }
+
+    BLASFUNC(s1norm)(&n, q_buf, &incq, r_buf, &incr);
+
+    for (i = 0; i < n * labs(incr); i++) {
+        float d = fabsf(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+
+    return maxdiff;
+}
+#ifndef NO_CBLAS
+static float c_api_check_1norm(blasint n,  blasint incq, blasint incr)
+{
+    blasint i;
+    float maxdiff = 0.0;
+
+    for (i = 0; i < n * labs(incr) * 2; i++) r_buf[i] = 0.0;
+
+    cblas_s1norm(n, q_buf, incq, r_buf, incr);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        float d = fabsf(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+
+    return maxdiff;
+}
+#endif
+
+CTEST(s1norm, all_1_N_100)
+{
+    float diff = check_1norm(DATASIZE, 1,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(s1norm, c_api_all_1_N_100)
+{
+    float diff = c_api_check_1norm(DATASIZE, 1,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(s1norm, incr_2_N_100)
