+{
+    double diff = check_3dot(DATASIZE, -1, 1, 1, 1, 1, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0, diff, DOUBLE_EPS);
+}
+
+CTEST(d3dot, neg_incy2_N_100)
+{
+    double diff = check_3dot(DATASIZE, 1, 1, 1, 1, -1, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0, diff, DOUBLE_EPS);
+}
+
+CTEST(d3dot, neg_2_2_2_2_2_2_neg_1_N_100)
+{
+    double diff = check_3dot(DATASIZE, -2, -2, -2, -2, -2, -2, -1);
+    ASSERT_DBL_NEAR_TOL(0.0, diff, DOUBLE_EPS);
+}
+
+CTEST(d3dot, incx1_0_N_100)
+{
+    double diff = check_3dot(DATASIZE, 0, 1, 1, 1, 1, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0, diff, DOUBLE_EPS);
+}
+
+CTEST(d3dot, n_zero)
+{
+    double diff = check_3dot(0, 1, 1, 1, 1, 1, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0, diff, DOUBLE_EPS);
+}
+
+#ifndef NO_CBLAS
+CTEST(d3dot, c_api_inc_1_1_1_1_1_1_1_N_100)
