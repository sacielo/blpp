+
+static void c_prod(double *o0, double *o1, double a0, double a1, double b0, double b1) {
+    *o0 = a0 * b0 - a1 * b1;
+    *o1 = a0 * b1 + a1 * b0;
+}
+
+static float check_3dotxy_dotxz(blasint n,  blasint incx1, blasint incx2, blasint incx3, blasint incy1, blasint incy2, blasint incy3, blasint incw1, blasint incw2, blasint incw3, blasint incr, blasint incq)
