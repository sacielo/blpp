+    BLASFUNC(z3crosssqr)(&n, x1_buf, &incx1, x2_buf, &incx2, x3_buf, &incx3, y1_buf, &incy1, y2_buf, &incy2, y3_buf, &incy3, r_buf, &incr);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        double d = fabs(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+
+    return maxdiff;
+}
+
+#ifndef NO_CBLAS
+static float c_api_check_3crosssqr(blasint n,  blasint incx1, blasint incx2, blasint incx3, blasint incy1, blasint incy2, blasint incy3, blasint incr)
+{
+    blasint i;
+    double maxdiff = 0.0;
+
+    for (i = 0; i < n * labs(incr) * 2; i++) r_buf[i] = 0.0;
+
+    cblas_z3crosssqr(n, x1_buf, incx1, x2_buf, incx2, x3_buf, incx3, y1_buf, incy1, y2_buf, incy2, y3_buf, incy3, r_buf, incr);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        double d = fabs(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+
+    return maxdiff;
+}
+#endif
+
