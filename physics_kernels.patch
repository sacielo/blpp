+    srand_generate(y2_buf, n * labs(incy2));
+    srand_generate(y3_buf, n * labs(incy3));
+
+    for (i = 0; i < n * labs(incr); i++) r_buf[i] = 0.0;
+    for (i = 0; i < n * labs(incr); i++) r_ref[i] = 0.0;
+
+    for (i = 0; i < n; i++) {
+    blasint ox1,
+         ox2,
+         ox3,
+         oy1,
+         oy2,
+         oy3,
+         or;
+        ox1 = (incx1 >= 0) ? i * incx1 : (n - 1 - i) * (-incx1);
+        ox2 = (incx2 >= 0) ? i * incx2 : (n - 1 - i) * (-incx2);
+        ox3 = (incx3 >= 0) ? i * incx3 : (n - 1 - i) * (-incx3);
+        oy1 = (incy1 >= 0) ? i * incy1 : (n - 1 - i) * (-incy1);
+        oy2 = (incy2 >= 0) ? i * incy2 : (n - 1 - i) * (-incy2);
+        oy3 = (incy3 >= 0) ? i * incy3 : (n - 1 - i) * (-incy3);
+        or = (incr >= 0) ? i * incr : (n - 1 - i) * (-incr);
+
+        {
+        float c1, c2, c3;
+        c1 = x2_buf[ox2] * y3_buf[oy3] - x3_buf[ox3] * y2_buf[oy2];
+        c2 = x3_buf[ox3] * y1_buf[oy1] - x1_buf[ox1] * y3_buf[oy3];
+        c3 = x1_buf[ox1] * y2_buf[oy2] - x2_buf[ox2] * y1_buf[oy1];
+        r_ref[or] = c1 * c1 + c2 * c2 + c3 * c3;
+        }
+    }
+
+    BLASFUNC(s3crosssqr)(&n, x1_buf, &incx1, x2_buf, &incx2, x3_buf, &incx3, y1_buf, &incy1, y2_buf, &incy2, y3_buf, &incy3, r_buf, &incr);
+
+    for (i = 0; i < n * labs(incr); i++) {
+        float d = fabsf(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+
+    return maxdiff;
+}
