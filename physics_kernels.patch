+    srand_generate(x2_buf, n * labs(incx2) * 2);
+    srand_generate(x3_buf, n * labs(incx3) * 2);
+    srand_generate(y1_buf, n * labs(incy1) * 2);
+    srand_generate(y2_buf, n * labs(incy2) * 2);
+    srand_generate(y3_buf, n * labs(incy3) * 2);
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        r_buf[i] = 0.0f;
+        r_ref[i] = 0.0f;
+    }
+
+    for (i = 0; i < n; i++) {
+        blasint ox1 = (incx1 >= 0) ? i * incx1 : (n - 1 - i) * (-incx1);
+        blasint ox2 = (incx2 >= 0) ? i * incx2 : (n - 1 - i) * (-incx2);
+        blasint ox3 = (incx3 >= 0) ? i * incx3 : (n - 1 - i) * (-incx3);
+        blasint oy1 = (incy1 >= 0) ? i * incy1 : (n - 1 - i) * (-incy1);
+        blasint oy2 = (incy2 >= 0) ? i * incy2 : (n - 1 - i) * (-incy2);
+        blasint oy3 = (incy3 >= 0) ? i * incy3 : (n - 1 - i) * (-incy3);
+        blasint orr = (incr  >= 0) ? i * incr  : (n - 1 - i) * (-incr);
+        float x1r = x1_buf[2 * ox1], x1i = x1_buf[2 * ox1 + 1];
+        float x2r = x2_buf[2 * ox2], x2i = x2_buf[2 * ox2 + 1];
+        float x3r = x3_buf[2 * ox3], x3i = x3_buf[2 * ox3 + 1];
+        float y1r = y1_buf[2 * oy1], y1i = y1_buf[2 * oy1 + 1];
+        float y2r = y2_buf[2 * oy2], y2i = y2_buf[2 * oy2 + 1];
+        float y3r = y3_buf[2 * oy3], y3i = y3_buf[2 * oy3 + 1];
+        r_ref[2 * orr]     = x1r * y1r - x1i * y1i + x2r * y2r - x2i * y2i + x3r * y3r - x3i * y3i;
+        r_ref[2 * orr + 1] = x1r * y1i + x1i * y1r + x2r * y2i + x2i * y2r + x3r * y3i + x3i * y3r;
+    }
