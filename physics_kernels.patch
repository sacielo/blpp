+++ b/utest/test_extensions/test_c1norm.c
@@ -0,0 +1,174 @@
+/**********************************************************************************/
+/*                                                                                */
+/*  c1norm kernel unit tests                                                      */
+/*                                                                                */
+/**********************************************************************************/
+
+#include "utest/openblas_utest.h"
+#include "common.h"
+
+#define DATASIZE 100
+#define INCREMENT 2
+#define BUFFER (DATASIZE * INCREMENT * 2)
+
+#ifdef BUILD_COMPLEX
+static float q_buf[BUFFER];
+static float r_buf[BUFFER];
+static float r_ref[BUFFER];
+
+static void c_prod(float *o0, float *o1, float a0, float a1, float b0, float b1) {
+    *o0 = a0 * b0 - a1 * b1;
+    *o1 = a0 * b1 + a1 * b0;
+}
+
+static float check_1norm(blasint n,  blasint incq, blasint incr)
+{
+    blasint i;
+    float maxdiff = 0.0;
+
+    srand_generate(q_buf, n * labs(incq) * 2);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) r_buf[i] = 0.0;
+    for (i = 0; i < n * labs(incr) * 2; i++) r_ref[i] = 0.0;
+
+    for (i = 0; i < n; i++) {
+    blasint oq,
+         or;
+        oq = (incq >= 0) ? i * incq : (n - 1 - i) * (-incq);
+        or = (incr >= 0) ? i * incr : (n - 1 - i) * (-incr);
+
+        {
+        float p0, p1, m;
+        c_prod(&p0, &p1, q_buf[2*oq], q_buf[2*oq+1], q_buf[2*oq], q_buf[2*oq+1]);
+        m = sqrtf(p0 * p0 + p1 * p1);
+        r_ref[2*or] = sqrtf((m + p0) / 2.0);
+        r_ref[2*or+1] = copysignf(sqrtf((m - p0) / 2.0), p1);
+        }
+    }
+
+    BLASFUNC(c1norm)(&n, q_buf, &incq, r_buf, &incr);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        float d = fabsf(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+
+    return maxdiff;
+}
+
+#ifndef NO_CBLAS
+static float c_api_check_1norm(blasint n,  blasint incq, blasint incr)
+{
+    blasint i;
+    float maxdiff = 0.0;
+
+    for (i = 0; i < n * labs(incr) * 2; i++) r_buf[i] = 0.0;
+
+    cblas_c1norm(n, q_buf, incq, r_buf, incr);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        float d = fabsf(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+
+    return maxdiff;
+}
+#endif
+
+CTEST(c1norm, all_1_N_100)
+{
+    float diff = check_1norm(DATASIZE, 1,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c1norm, c_api_all_1_N_100)
+{
+    float diff = c_api_check_1norm(DATASIZE, 1,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c1norm, incr_2_N_100)
+{
+    float diff = check_1norm(DATASIZE, 1,2);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c1norm, c_api_incr_2_N_100)
+{
+    float diff = c_api_check_1norm(DATASIZE, 1,2);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c1norm, all_2_N_100)
+{
+    float diff = check_1norm(DATASIZE, 2,2);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c1norm, c_api_all_2_N_100)
+{
+    float diff = c_api_check_1norm(DATASIZE, 2,2);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c1norm, neg_incq_N_100)
+{
+    float diff = check_1norm(DATASIZE, -1,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c1norm, c_api_neg_incq_N_100)
+{
+    float diff = c_api_check_1norm(DATASIZE, -1,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c1norm, neg_incr_N_100)
+{
+    float diff = check_1norm(DATASIZE, 1,-1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c1norm, c_api_neg_incr_N_100)
+{
+    float diff = c_api_check_1norm(DATASIZE, 1,-1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c1norm, neg_all_N_100)
+{
+    float diff = check_1norm(DATASIZE, -2,-1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c1norm, c_api_neg_all_N_100)
+{
+    float diff = c_api_check_1norm(DATASIZE, -2,-1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c1norm, incq_0_N_100)
+{
+    float diff = check_1norm(DATASIZE, 0,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c1norm, c_api_incq_0_N_100)
+{
+    float diff = c_api_check_1norm(DATASIZE, 0,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c1norm, n_zero)
+{
+    float diff = check_1norm(0, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(c1norm, c_api_n_zero)
+{
+    float diff = c_api_check_1norm(0, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+#endif
