+CTEST(s3dot, neg_incx1_N_100)
+{
+    float diff = check_3dot(DATASIZE, -1, 1, 1, 1, 1, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(s3dot, neg_incy2_N_100)
+{
+    float diff = check_3dot(DATASIZE, 1, 1, 1, 1, -1, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(s3dot, neg_2_2_2_2_2_2_neg_1_N_100)
+{
+    float diff = check_3dot(DATASIZE, -2, -2, -2, -2, -2, -2, -1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(s3dot, incx1_0_N_100)
+{
+    float diff = check_3dot(DATASIZE, 0, 1, 1, 1, 1, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+CTEST(s3dot, n_zero)
+{
+    float diff = check_3dot(0, 1, 1, 1, 1, 1, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+}
+
+#ifndef NO_CBLAS
+CTEST(s3dot, c_api_inc_1_1_1_1_1_1_1_N_100)
+{
+    float diff = check_3dot(DATASIZE, 1, 1, 1, 1, 1, 1, 1);
+    float cdiff = c_api_check_3dot(DATASIZE, 1, 1, 1, 1, 1, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+    ASSERT_DBL_NEAR_TOL(0.0f, cdiff, SINGLE_EPS);
+}
+
+CTEST(s3dot, c_api_incx2_2_N_100)
+{
+    float diff = check_3dot(DATASIZE, 1, 2, 1, 1, 1, 1, 1);
+    float cdiff = c_api_check_3dot(DATASIZE, 1, 2, 1, 1, 1, 1, 1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+    ASSERT_DBL_NEAR_TOL(0.0f, cdiff, SINGLE_EPS);
+}
+
+CTEST(s3dot, c_api_inc_2_2_2_2_2_2_2_N_100)
+{
+    float diff = check_3dot(DATASIZE, 2, 2, 2, 2, 2, 2, 2);
+    float cdiff = c_api_check_3dot(DATASIZE, 2, 2, 2, 2, 2, 2, 2);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, SINGLE_EPS);
+    ASSERT_DBL_NEAR_TOL(0.0f, cdiff, SINGLE_EPS);
+}
+
+CTEST(s3dot, c_api_neg_2_2_2_2_2_2_neg_1_N_100)
+{
