+/**********************************************************************************/
+/*                                                                                */
+/*  s3cross kernel unit tests                                                      */
+/*                                                                                */
+/**********************************************************************************/
+
+#include "utest/openblas_utest.h"
+#include "common.h"
+
+#define DATASIZE 100
+#define INCREMENT 2
+#define BUFFER (DATASIZE * INCREMENT * 2)
+
+#ifdef BUILD_SINGLE
+static float x1_buf[BUFFER];
+static float x2_buf[BUFFER];
+static float x3_buf[BUFFER];
+static float y1_buf[BUFFER];
+static float y2_buf[BUFFER];
+static float y3_buf[BUFFER];
+static float w1_buf[BUFFER];
+static float w2_buf[BUFFER];
+static float w3_buf[BUFFER];
+static float w1_ref[BUFFER];
+static float w2_ref[BUFFER];
+static float w3_ref[BUFFER];
+
+
+static float check_3cross(blasint n,  blasint incx1, blasint incx2, blasint incx3, blasint incy1, blasint incy2, blasint incy3, blasint incw1, blasint incw2, blasint incw3)
+{
+    blasint i;
+    float maxdiff = 0.0;
+
+    srand_generate(x1_buf, n * labs(incx1));
+    srand_generate(x2_buf, n * labs(incx2));
+    srand_generate(x3_buf, n * labs(incx3));
+    srand_generate(y1_buf, n * labs(incy1));
+    srand_generate(y2_buf, n * labs(incy2));
+    srand_generate(y3_buf, n * labs(incy3));
+
+    for (i = 0; i < n * labs(incw1); i++) w1_buf[i] = 0.0;
+    for (i = 0; i < n * labs(incw2); i++) w2_buf[i] = 0.0;
+    for (i = 0; i < n * labs(incw3); i++) w3_buf[i] = 0.0;
+    for (i = 0; i < n * labs(incw1); i++) w1_ref[i] = 0.0;
+    for (i = 0; i < n * labs(incw2); i++) w2_ref[i] = 0.0;
+    for (i = 0; i < n * labs(incw3); i++) w3_ref[i] = 0.0;
+
+    for (i = 0; i < n; i++) {
+    blasint ox1,
+         ox2,
+         ox3,
+         oy1,
+         oy2,
+         oy3,
+         ow1,
+         ow2,
+         ow3;
+        ox1 = (incx1 >= 0) ? i * incx1 : (n - 1 - i) * (-incx1);
+        ox2 = (incx2 >= 0) ? i * incx2 : (n - 1 - i) * (-incx2);
+        ox3 = (incx3 >= 0) ? i * incx3 : (n - 1 - i) * (-incx3);
+        oy1 = (incy1 >= 0) ? i * incy1 : (n - 1 - i) * (-incy1);
+        oy2 = (incy2 >= 0) ? i * incy2 : (n - 1 - i) * (-incy2);
+        oy3 = (incy3 >= 0) ? i * incy3 : (n - 1 - i) * (-incy3);
+        ow1 = (incw1 >= 0) ? i * incw1 : (n - 1 - i) * (-incw1);
+        ow2 = (incw2 >= 0) ? i * incw2 : (n - 1 - i) * (-incw2);
+        ow3 = (incw3 >= 0) ? i * incw3 : (n - 1 - i) * (-incw3);
+
