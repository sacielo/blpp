+    ASSERT_DBL_NEAR_TOL(0.0f, diff, DOUBLE_EPS);
+}
+
+CTEST(z3cross, c_api_all_2_N_100)
+{
+    float diff = c_api_check_3cross(DATASIZE, 2,2,2,2,2,2,2,2,2);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, DOUBLE_EPS);
+}
+
+CTEST(z3cross, neg_incx1_N_100)
+{
+    float diff = check_3cross(DATASIZE, -1,1,1,1,1,1,1,1,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, DOUBLE_EPS);
