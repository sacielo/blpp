+			w1[2*(i+1)] = p0; w1[2*(i+1)+1] = p1;
+			p0 = x2[2*(i+1)] * y2[2*(i+1)] - x2[2*(i+1)+1] * y2[2*(i+1)+1];
+			p1 = x2[2*(i+1)] * y2[2*(i+1)+1] + x2[2*(i+1)+1] * y2[2*(i+1)];
+			w2[2*(i+1)] = p0; w2[2*(i+1)+1] = p1;
+			p0 = x3[2*(i+1)] * y3[2*(i+1)] - x3[2*(i+1)+1] * y3[2*(i+1)+1];
+			p1 = x3[2*(i+1)] * y3[2*(i+1)+1] + x3[2*(i+1)+1] * y3[2*(i+1)];
+			w3[2*(i+1)] = p0; w3[2*(i+1)+1] = p1;
+			p0 = x1[2*(i+2)] * y1[2*(i+2)] - x1[2*(i+2)+1] * y1[2*(i+2)+1];
+			p1 = x1[2*(i+2)] * y1[2*(i+2)+1] + x1[2*(i+2)+1] * y1[2*(i+2)];
+			w1[2*(i+2)] = p0; w1[2*(i+2)+1] = p1;
+			p0 = x2[2*(i+2)] * y2[2*(i+2)] - x2[2*(i+2)+1] * y2[2*(i+2)+1];
+			p1 = x2[2*(i+2)] * y2[2*(i+2)+1] + x2[2*(i+2)+1] * y2[2*(i+2)];
+			w2[2*(i+2)] = p0; w2[2*(i+2)+1] = p1;
+			p0 = x3[2*(i+2)] * y3[2*(i+2)] - x3[2*(i+2)+1] * y3[2*(i+2)+1];
+			p1 = x3[2*(i+2)] * y3[2*(i+2)+1] + x3[2*(i+2)+1] * y3[2*(i+2)];
+			w3[2*(i+2)] = p0; w3[2*(i+2)+1] = p1;
+			p0 = x1[2*(i+3)] * y1[2*(i+3)] - x1[2*(i+3)+1] * y1[2*(i+3)+1];
+			p1 = x1[2*(i+3)] * y1[2*(i+3)+1] + x1[2*(i+3)+1] * y1[2*(i+3)];
+			w1[2*(i+3)] = p0; w1[2*(i+3)+1] = p1;
+			p0 = x2[2*(i+3)] * y2[2*(i+3)] - x2[2*(i+3)+1] * y2[2*(i+3)+1];
+			p1 = x2[2*(i+3)] * y2[2*(i+3)+1] + x2[2*(i+3)+1] * y2[2*(i+3)];
+			w2[2*(i+3)] = p0; w2[2*(i+3)+1] = p1;
+			p0 = x3[2*(i+3)] * y3[2*(i+3)] - x3[2*(i+3)+1] * y3[2*(i+3)+1];
+			p1 = x3[2*(i+3)] * y3[2*(i+3)+1] + x3[2*(i+3)+1] * y3[2*(i+3)];
+			w3[2*(i+3)] = p0; w3[2*(i+3)+1] = p1;
+		}
+		while (i < n) {
+			p0 = x1[2*i] * y1[2*i] - x1[2*i+1] * y1[2*i+1];
+			p1 = x1[2*i] * y1[2*i+1] + x1[2*i+1] * y1[2*i];
+			w1[2*i] = p0; w1[2*i+1] = p1;
+			p0 = x2[2*i] * y2[2*i] - x2[2*i+1] * y2[2*i+1];
+			p1 = x2[2*i] * y2[2*i+1] + x2[2*i+1] * y2[2*i];
+			w2[2*i] = p0; w2[2*i+1] = p1;
+			p0 = x3[2*i] * y3[2*i] - x3[2*i+1] * y3[2*i+1];
+			p1 = x3[2*i] * y3[2*i+1] + x3[2*i+1] * y3[2*i];
+			w3[2*i] = p0; w3[2*i+1] = p1;
+			i++;
+		}
+	}
+	else {
+		while (i < n) {
+			if (incw1 != 0) {
+				p0 = x1[ix1] * y1[iy1] - x1[ix1+1] * y1[iy1+1];
+				p1 = x1[ix1] * y1[iy1+1] + x1[ix1+1] * y1[iy1];
+				w1[ow1] = p0; w1[ow1+1] = p1;
+			}
+			if (incw2 != 0) {
+				p0 = x2[ix2] * y2[iy2] - x2[ix2+1] * y2[iy2+1];
+				p1 = x2[ix2] * y2[iy2+1] + x2[ix2+1] * y2[iy2];
+				w2[ow2] = p0; w2[ow2+1] = p1;
+			}
+			if (incw3 != 0) {
+				p0 = x3[ix3] * y3[iy3] - x3[ix3+1] * y3[iy3+1];
+				p1 = x3[ix3] * y3[iy3+1] + x3[ix3+1] * y3[iy3];
+				w3[ow3] = p0; w3[ow3+1] = p1;
+			}
+			ix1 += incx1;
+			ix2 += incx2;
+			ix3 += incx3;
+			iy1 += incy1;
+			iy2 += incy2;
+			iy3 += incy3;
+			ow1 += incw1;
+			ow2 += incw2;
+			ow3 += incw3;
+			i++;
+		}
+	}
+	return(0);
+}
