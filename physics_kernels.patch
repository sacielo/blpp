+/**********************************************************************************/
+/*                                                                                */
+/*  z1norm kernel unit tests                                                      */
+/*                                                                                */
+/**********************************************************************************/
+
+#include "utest/openblas_utest.h"
+#include "common.h"
+
+#define DATASIZE 100
+#define INCREMENT 2
+#define BUFFER (DATASIZE * INCREMENT * 2)
+
+#ifdef BUILD_COMPLEX16
+static double q_buf[BUFFER];
+static double r_buf[BUFFER];
+static double r_ref[BUFFER];
+
+static void c_prod(double *o0, double *o1, double a0, double a1, double b0, double b1) {
+    *o0 = a0 * b0 - a1 * b1;
+    *o1 = a0 * b1 + a1 * b0;
+}
+
+static float check_1norm(blasint n,  blasint incq, blasint incr)
+{
+    blasint i;
+    double maxdiff = 0.0;
+
+    drand_generate(q_buf, n * labs(incq) * 2);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) r_buf[i] = 0.0;
+    for (i = 0; i < n * labs(incr) * 2; i++) r_ref[i] = 0.0;
+
+    for (i = 0; i < n; i++) {
+    blasint oq,
+         or;
+        oq = (incq >= 0) ? i * incq : (n - 1 - i) * (-incq);
+        or = (incr >= 0) ? i * incr : (n - 1 - i) * (-incr);
+
+        {
+        double p0, p1, m;
+        c_prod(&p0, &p1, q_buf[2*oq], q_buf[2*oq+1], q_buf[2*oq], q_buf[2*oq+1]);
+        m = sqrt(p0 * p0 + p1 * p1);
+        r_ref[2*or] = sqrt((m + p0) / 2.0);
+        r_ref[2*or+1] = copysign(sqrt((m - p0) / 2.0), p1);
+        }
+    }
+
+    BLASFUNC(z1norm)(&n, q_buf, &incq, r_buf, &incr);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        double d = fabs(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+
+    return maxdiff;
+}
+
+#ifndef NO_CBLAS
+static float c_api_check_1norm(blasint n,  blasint incq, blasint incr)
+{
+    blasint i;
+    double maxdiff = 0.0;
+
+    for (i = 0; i < n * labs(incr) * 2; i++) r_buf[i] = 0.0;
+
+    cblas_z1norm(n, q_buf, incq, r_buf, incr);
+
+    for (i = 0; i < n * labs(incr) * 2; i++) {
+        double d = fabs(r_buf[i] - r_ref[i]);
+        if (d > maxdiff) maxdiff = d;
+    }
+
+    return maxdiff;
+}
+#endif
+
+CTEST(z1norm, all_1_N_100)
+{
+    float diff = check_1norm(DATASIZE, 1,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, DOUBLE_EPS);
+}
+
+CTEST(z1norm, c_api_all_1_N_100)
+{
+    float diff = c_api_check_1norm(DATASIZE, 1,1);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, DOUBLE_EPS);
+}
+
+CTEST(z1norm, incr_2_N_100)
+{
+    float diff = check_1norm(DATASIZE, 1,2);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, DOUBLE_EPS);
+}
+
+CTEST(z1norm, c_api_incr_2_N_100)
+{
+    float diff = c_api_check_1norm(DATASIZE, 1,2);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, DOUBLE_EPS);
+}
+
+CTEST(z1norm, all_2_N_100)
+{
+    float diff = check_1norm(DATASIZE, 2,2);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, DOUBLE_EPS);
+}
+
+CTEST(z1norm, c_api_all_2_N_100)
+{
+    float diff = c_api_check_1norm(DATASIZE, 2,2);
+    ASSERT_DBL_NEAR_TOL(0.0f, diff, DOUBLE_EPS);
+}
+
+CTEST(z1norm, neg_incq_N_100)
